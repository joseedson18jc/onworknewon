{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/faceswap.js": { "maxDuration": 60 },
    "api/send-email.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
